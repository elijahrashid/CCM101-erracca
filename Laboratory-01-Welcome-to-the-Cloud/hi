<#
.SYNOPSIS
    SysAdminToolkit.ps1 - A PowerShell script for Windows System Administration and Automation.

.DESCRIPTION
    Demonstrates the use of PowerShell as a scripting language for system administration.
    The toolkit manages three core areas:
        1. Computers        - system information, uptime, restart/shutdown
        2. Drives & Files    - disk usage, file search, temp file cleanup
        3. Processes & Services - list, start, stop, and restart processes/services

.NOTES
    Author  : (Your Name)
    Purpose : Laboratory demonstration - Scripting Languages for System Administration
    Run as  : Administrator (recommended, required for some actions)
#>

# ============================================================
#  GLOBAL SETTINGS
# ============================================================
$ErrorActionPreference = "Stop"
$LogFile = "$PSScriptRoot\SysAdminToolkit_Log.txt"

function Write-Log {
    param([string]$Message)
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "[$timestamp] $Message"
    Add-Content -Path $LogFile -Value $entry
    Write-Host $entry -ForegroundColor DarkGray
}

# ============================================================
#  MODULE 1: COMPUTER MANAGEMENT
# ============================================================

function Get-ComputerSummary {
    Write-Host "`n===== COMPUTER INFORMATION =====" -ForegroundColor Cyan
    $os  = Get-CimInstance Win32_OperatingSystem
    $cs  = Get-CimInstance Win32_ComputerSystem
    $cpu = Get-CimInstance Win32_Processor

    [PSCustomObject]@{
        ComputerName = $env:COMPUTERNAME
        OS           = $os.Caption
        Version      = $os.Version
        Manufacturer = $cs.Manufacturer
        Model        = $cs.Model
        CPU          = $cpu.Name
        TotalRAM_GB  = [math]::Round($cs.TotalPhysicalMemory / 1GB, 2)
        LastBootTime = $os.LastBootUpTime
        Uptime       = (Get-Date) - $os.LastBootUpTime
    } | Format-List

    Write-Log "Displayed computer summary for $env:COMPUTERNAME"
}

function Restart-TargetComputer {
    $confirm = Read-Host "Are you sure you want to RESTART this computer? (Y/N)"
    if ($confirm -eq "Y") {
        Write-Log "User initiated computer restart."
        Restart-Computer -Force
    } else {
        Write-Host "Restart cancelled." -ForegroundColor Yellow
    }
}

function Stop-TargetComputer {
    $confirm = Read-Host "Are you sure you want to SHUT DOWN this computer? (Y/N)"
    if ($confirm -eq "Y") {
        Write-Log "User initiated computer shutdown."
        Stop-Computer -Force
    } else {
        Write-Host "Shutdown cancelled." -ForegroundColor Yellow
    }
}

# ============================================================
#  MODULE 2: DRIVE & FILE MANAGEMENT
# ============================================================

function Get-DriveUsage {
    Write-Host "`n===== DRIVE USAGE =====" -ForegroundColor Cyan
    Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" |
        Select-Object DeviceID,
            @{N='Size(GB)'; E={[math]::Round($_.Size/1GB,2)}},
            @{N='Free(GB)'; E={[math]::Round($_.FreeSpace/1GB,2)}},
            @{N='Used(%)';  E={[math]::Round((($_.Size-$_.FreeSpace)/$_.Size)*100,1)}} |
        Format-Table -AutoSize

    Write-Log "Displayed drive usage report."
}

function Find-LargeFiles {
    $path = Read-Host "Enter folder path to scan (e.g. C:\Users)"
    $minMB = Read-Host "Minimum file size in MB (e.g. 100)"
    Write-Host "`nScanning $path for files larger than $minMB MB..." -ForegroundColor Cyan

    Get-ChildItem -Path $path -Recurse -File -ErrorAction SilentlyContinue |
        Where-Object { $_.Length -gt ($minMB * 1MB) } |
        Sort-Object Length -Descending |
        Select-Object FullName, @{N='Size(MB)'; E={[math]::Round($_.Length/1MB,2)}} |
        Format-Table -AutoSize

    Write-Log "Searched for large files in $path (>${minMB}MB)."
}

function Clear-TempFiles {
    $tempPath = $env:TEMP
    $confirm = Read-Host "This will delete temporary files in $tempPath. Continue? (Y/N)"
    if ($confirm -eq "Y") {
        $before = (Get-ChildItem $tempPath -Recurse -File -ErrorAction SilentlyContinue |
                   Measure-Object -Property Length -Sum).Sum / 1MB
        Get-ChildItem $tempPath -Recurse -Force -ErrorAction SilentlyContinue |
            Remove-Item -Force -Recurse -ErrorAction SilentlyContinue
        Write-Host ("Cleanup complete. Approximately {0:N2} MB freed." -f $before) -ForegroundColor Green
        Write-Log ("Cleared temp files. Freed approx {0:N2} MB." -f $before)
    } else {
        Write-Host "Cleanup cancelled." -ForegroundColor Yellow
    }
}

# ============================================================
#  MODULE 3: PROCESS & SERVICE MANAGEMENT
# ============================================================

function Get-TopProcesses {
    Write-Host "`n===== TOP 10 PROCESSES BY CPU/MEMORY =====" -ForegroundColor Cyan
    Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 |
        Format-Table Name, Id, CPU,
            @{N='Mem(MB)'; E={[math]::Round($_.WorkingSet64/1MB,2)}} -AutoSize
    Write-Log "Displayed top 10 processes."
}

function Stop-TargetProcess {
    $name = Read-Host "Enter process name to stop (e.g. notepad)"
    try {
        Stop-Process -Name $name -Force -ErrorAction Stop
        Write-Host "Process '$name' stopped." -ForegroundColor Green
        Write-Log "Stopped process: $name"
    } catch {
        Write-Host "Could not stop process '$name': $_" -ForegroundColor Red
    }
}

function Get-ServiceStatusReport {
    $filter = Read-Host "Enter part of a service name to filter (blank = all running)"
    if ([string]::IsNullOrWhiteSpace($filter)) {
        Get-Service | Where-Object { $_.Status -eq 'Running' } |
            Sort-Object DisplayName | Format-Table Name, DisplayName, Status -AutoSize
    } else {
        Get-Service | Where-Object { $_.DisplayName -like "*$filter*" } |
            Format-Table Name, DisplayName, Status -AutoSize
    }
    Write-Log "Displayed service status report (filter: '$filter')."
}

function Set-ServiceState {
    $name = Read-Host "Enter exact service Name (not DisplayName)"
    $action = Read-Host "Action - (S)tart, (T)op stop, (R)estart"
    try {
        switch ($action.ToUpper()) {
            "S" { Start-Service -Name $name; Write-Host "Service '$name' started." -ForegroundColor Green }
            "T" { Stop-Service -Name $name -Force; Write-Host "Service '$name' stopped." -ForegroundColor Green }
            "R" { Restart-Service -Name $name -Force; Write-Host "Service '$name' restarted." -ForegroundColor Green }
            default { Write-Host "Invalid action." -ForegroundColor Yellow }
        }
        Write-Log "Service action '$action' performed on '$name'."
    } catch {
        Write-Host "Error managing service '$name': $_" -ForegroundColor Red
    }
}

# ============================================================
#  MAIN MENU
# ============================================================

function Show-Menu {
    Clear-Host
    Write-Host "=================================================="
    Write-Host "   SYSADMIN TOOLKIT - PowerShell Automation Script"
    Write-Host "=================================================="
    Write-Host " COMPUTER MANAGEMENT"
    Write-Host "  1. Show computer summary"
    Write-Host "  2. Restart computer"
    Write-Host "  3. Shut down computer"
    Write-Host " DRIVE & FILE MANAGEMENT"
    Write-Host "  4. Show drive usage"
    Write-Host "  5. Find large files"
    Write-Host "  6. Clear temp files"
    Write-Host " PROCESS & SERVICE MANAGEMENT"
    Write-Host "  7. Show top processes"
    Write-Host "  8. Stop a process"
    Write-Host "  9. Show service status"
    Write-Host " 10. Start/Stop/Restart a service"
    Write-Host "  0. Exit"
    Write-Host "=================================================="
}

do {
    Show-Menu
    $choice = Read-Host "Select an option"
    switch ($choice) {
        "1"  { Get-ComputerSummary }
        "2"  { Restart-TargetComputer }
        "3"  { Stop-TargetComputer }
        "4"  { Get-DriveUsage }
        "5"  { Find-LargeFiles }
        "6"  { Clear-TempFiles }
        "7"  { Get-TopProcesses }
        "8"  { Stop-TargetProcess }
        "9"  { Get-ServiceStatusReport }
        "10" { Set-ServiceState }
        "0"  { Write-Host "Exiting SysAdmin Toolkit. Goodbye!" -ForegroundColor Cyan }
        default { Write-Host "Invalid selection, try again." -ForegroundColor Red }
    }
    if ($choice -ne "0") { Read-Host "`nPress Enter to return to the menu" }
} while ($choice -ne "0")
